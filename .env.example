# Server Familiar — example environment. Copy to .env and fill in.
# Never commit .env, and never put a real token in this file.

# --- Lab ---------------------------------------------------------------
LAB_ADDR=:8787
LAB_DB=familiar.db
# Run the simulated six-familiar fleet; no agents or servers needed.
LAB_DEMO=0
# Token an agent presents once, to enrol. Generate with: openssl rand -hex 32
LAB_FLEET_TOKEN=

# --- Brain (optional) --------------------------------------------------
# Any OpenAI-compatible endpoint. With these unset, diary, dreams, and chat
# fall back to grounded templates; nothing hard-fails for lack of a key.
LAB_LLM_BASE_URL=
LAB_LLM_MODEL=
LAB_LLM_API_KEY=
LAB_LLM_DAILY_TOKEN_BUDGET=50000

# --- Telegram (optional) -----------------------------------------------
# Ask-first approvals, guard alerts, death and resurrection notices.
LAB_TELEGRAM_BOT_TOKEN=
LAB_TELEGRAM_CHAT_ID=

# --- Agent -------------------------------------------------------------
AGENT_LAB_URL=http://localhost:8787
# The fleet token before enrolment, this familiar's own token afterwards.
AGENT_TOKEN=
AGENT_DISK_PATH=/
